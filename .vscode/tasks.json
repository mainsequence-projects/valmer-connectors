{
  "version": "2.0.0",
  "tasks": [
      {
        "label": "Create .venv (Python 3.13)",
        "type": "shell",
        "command": "uv venv --python 3.13 ${workspaceFolder}/.venv",
        "problemMatcher": []
      },
      {
        "label": "Sync locked environment (Python 3.13)",
        "type": "shell",
        "command": "uv sync --locked --python 3.13",
        "problemMatcher": []
      },
      {
        "label": "Run Streamlit (Dashboard)",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/streamlit run ${workspaceFolder}/dashboards/sample_app/app.py",
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Run Example Script",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/scripts/test_script.py",
        "problemMatcher": []
      },
      {
        "label": "Control Plane: Wait for local API",
        "type": "process",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "${workspaceFolder}/.vscode/wait_for_http.py",
          "http://127.0.0.1:8000/health",
          "30"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent",
          "panel": "dedicated",
          "group": "control-plane"
        }
      },
      {
        "label": "Setup environment",
        "dependsOn": [
          "Create .venv (Python 3.13)",
          "Sync locked environment (Python 3.13)"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": []
      }
  ]
}
