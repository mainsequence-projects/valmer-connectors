{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Valmer Dashboard",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/dashboards/valmer_monitor/app.py"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Migrations: Current (Valmer)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "mainsequence",
      "args": [
        "migrations",
        "current",
        "--provider",
        "migrations:migration",
        "--verbose",
        "--timeout",
        "900",
        "--ttl-seconds",
        "900"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Migrations: Revision (Valmer)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "mainsequence",
      "args": [
        "migrations",
        "revision",
        "--provider",
        "migrations:migration",
        "--autogenerate",
        "--message",
        "migration",
        "--timeout",
        "60",
        "--ttl-seconds",
        "120",
        "--json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Migrations: Upgrade (Valmer)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "mainsequence",
      "args": [
        "migrations",
        "upgrade",
        "--provider",
        "migrations:migration",
        "head",
        "--timeout",
        "900",
        "--ttl-seconds",
        "900"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Valmer CLI: Vector Update",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "valmer_connectors.cli.main",
      "args": [
        "vector",
        "update"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Valmer CLI: Vector Update From Upload Folder",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "valmer_connectors.cli.main",
      "args": [
        "vector",
        "update",
        "--local-bucket-path-env-var",
        "VALMER_VECTOR_UPLOAD_DEBUG_PATH"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Valmer CLI: Vector Update From OneDrive Graph",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "valmer_connectors.cli.main",
      "args": [
        "vector",
        "update",
        "--source",
        "onedrive-graph"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
