    {
      "name": "Migrations: Current (Valmer)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "mainsequence",
      "args": [
        "migrations",
        "current",
        "--provider",
        "migrations:migration",
        "--verbose",
        "--timeout",
        "900",
        "--ttl-seconds",
        "900"
