{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Valmer Dashboard",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/dashboards/valmer_monitor/app.py"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Migrations: Current (Valmer)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/mainsequence",
      "args": [
        "migrations",
        "current",
        "--provider",
        "migrations:migration",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": true
    },
    {
      "name": "Migrations: Revision (Valmer)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/mainsequence",
      "args": [
        "migrations",
        "revision",
        "--provider",
        "migrations:migration",
        "--message",
        "${input:migrationRevisionMessage}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": true
    },
    {
      "name": "Migrations: Upgrade (Valmer)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/mainsequence",
      "args": [
        "migrations",
        "upgrade",
        "--provider",
        "migrations:migration",
        "${input:migrationTargetRevision}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": true
    },
    {
      "name": "Example Script",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_script.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "migrationRevisionMessage",
      "type": "promptString",
      "description": "Alembic revision message",
      "default": "migration"
    },
    {
      "id": "migrationTargetRevision",
      "type": "promptString",
      "description": "Alembic target revision",
      "default": "head"
    }
  ]
}
